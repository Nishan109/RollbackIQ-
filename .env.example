# The demo and local CLI require no environment variables.
# Copy to apps/web/.env.local to configure the team workspace.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_USER_DAILY_LIMIT=10
GEMINI_TOTAL_DAILY_LIMIT=100
# GitHub App connection and background PR scans. All variables below are server-only.
# Apply the migrations in supabase/migrations before enabling this integration.
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM contents. Literal \n sequences are accepted; never commit the real key.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Worker-only production options. Both deployments must identify the same commit.
ROLLBACKIQ_RELEASE=
ROLLBACKIQ_WORKER_PRODUCTION=false
WORKER_HEALTH_PORT=8080
WORKER_HEALTH_HOST=127.0.0.1
